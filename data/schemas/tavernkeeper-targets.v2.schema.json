{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tavernary.org/schemas/tavernkeeper-targets.v2.schema.json",
  "title": "TavernKeeper V2 scan target manifest",
  "type": "object",
  "properties": {
    "schema_version": { "type": "number", "const": 2 },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": { "type": "string", "pattern": "^github-[1-9][0-9]*$" },
          "provider": { "type": "string", "const": "github" },
          "repository_id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "repository": {
            "type": "string",
            "pattern": "^[^/\\s]+\\/[^/\\s]+$"
          },
          "target_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "canonical_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https:\\/\\/github\\.com\\/.*"
          },
          "project_kinds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["extension", "frontend", "preset"]
            }
          },
          "catalog_priority": {
            "type": "object",
            "properties": {
              "top_30": { "type": "boolean" },
              "first_cataloged_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
              }
            },
            "required": ["top_30", "first_cataloged_at"],
            "additionalProperties": false
          }
        },
        "required": [
          "source_id",
          "provider",
          "repository_id",
          "repository",
          "target_sha",
          "canonical_url",
          "project_kinds",
          "catalog_priority"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "generated_at", "repositories"],
  "additionalProperties": false
}
