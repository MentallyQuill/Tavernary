{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tavernary catalog policy review state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "source_identity",
    "evidence_fingerprint",
    "policy_version",
    "status",
    "category",
    "reviewed_at",
    "retry",
    "maintenance_issue_number"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "source_identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "evidence_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "status": {
      "enum": ["clear", "review-suggested", "review-unavailable"]
    },
    "category": {
      "type": ["string", "null"],
      "enum": [
        null,
        "potential-hate-or-discrimination",
        "potential-sexual-content-involving-minors",
        "potential-other-catalog-policy-conflict"
      ]
    },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempts", "last_failure_at"],
      "properties": {
        "attempts": { "type": "integer", "minimum": 0 },
        "last_failure_at": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "maintenance_issue_number": {
      "type": ["integer", "null"],
      "minimum": 1
    }
  }
}
