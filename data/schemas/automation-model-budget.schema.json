{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tavernary writer-owned model budget v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updatedAt", "days", "months", "tickets"],
  "properties": {
    "schema_version": { "const": 1 },
    "updatedAt": { "type": "string", "format": "automation-time" },
    "days": {
      "type": "array",
      "maxItems": 366,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["day", "requests", "tokens"],
        "properties": {
          "day": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "requests": { "type": "integer", "minimum": 0, "maximum": 40 },
          "tokens": { "type": "integer", "minimum": 0, "maximum": 200000 }
        }
      }
    },
    "months": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["month", "reservedMicrousd", "unpricedTokens"],
        "properties": {
          "month": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
          "reservedMicrousd": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "unpricedTokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6200000
          }
        }
      }
    },
    "tickets": {
      "type": "array",
      "maxItems": 4000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "operationKey",
          "requestId",
          "day",
          "model",
          "requestCount",
          "requestedTokens",
          "price",
          "reservedMicrousd",
          "createdAt",
          "expiresAt",
          "producer",
          "settled",
          "usage"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "operationKey": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "requestId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "day": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "model": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          },
          "requestCount": { "type": "integer", "minimum": 1, "maximum": 40 },
          "requestedTokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200000
          },
          "price": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "model",
                  "inputUsdPerMillion",
                  "outputUsdPerMillion"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
                  },
                  "inputUsdPerMillion": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 10000
                  },
                  "outputUsdPerMillion": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 10000
                  }
                }
              }
            ]
          },
          "reservedMicrousd": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "createdAt": { "type": "string", "format": "automation-time" },
          "expiresAt": { "type": "string", "format": "automation-time" },
          "producer": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["runId", "workflow"],
                "properties": {
                  "runId": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "workflow": {
                    "enum": [
                      ".github/workflows/enrich-catalog.yml",
                      ".github/workflows/review-catalog-policy.yml",
                      ".github/workflows/import-tavernkeeper-reports.yml",
                      ".github/workflows/generate-project-submission.yml",
                      ".github/workflows/generate-project-owner-request.yml"
                    ]
                  }
                }
              }
            ]
          },
          "settled": { "type": "boolean" },
          "usage": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["requests", "tokens"],
                "properties": {
                  "requests": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 40
                  },
                  "tokens": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 200000
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
