{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tavernary.app/schemas/trusted-tavernary-editors.schema.json",
  "title": "Trusted Tavernary editors",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "editors"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "editors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["github_user_id", "login", "role"],
        "properties": {
          "github_user_id": {
            "type": "integer",
            "minimum": 1
          },
          "login": {
            "type": "string",
            "pattern": "^(?!-)[A-Za-z0-9-]{1,39}(?<!-)$"
          },
          "role": {
            "enum": ["owner", "admin", "maintainer"]
          }
        }
      }
    }
  }
}
