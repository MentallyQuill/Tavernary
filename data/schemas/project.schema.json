{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tavernary.org/schemas/project.schema.json",
  "title": "Tavernary curated project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "kind",
    "summary",
    "metadata_status",
    "source",
    "frontends",
    "primary_function",
    "capabilities",
    "cataloged_at",
    "catalog_cohort",
    "visibility",
    "visibility_reason",
    "refresh_policy",
    "enrichment_policy"
  ],
  "properties": {
    "schema_version": { "const": 4 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["frontend", "extension", "preset"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 220 },
    "metadata_status": { "enum": ["provisional", "curated"] },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "repository", "repository_id"],
          "properties": {
            "type": { "const": "github" },
            "repository": {
              "type": "string",
              "pattern": "^[^/\\s]+/[^/\\s]+$"
            },
            "repository_id": {
              "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "organization", "url"],
          "properties": {
            "type": { "const": "github-organization" },
            "organization": {
              "type": "string",
              "pattern": "^[^/\\s]+$"
            },
            "url": { "type": "string", "format": "uri" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "url",
            "published_at",
            "version",
            "artifact_size_bytes",
            "license_status",
            "license_spdx_id"
          ],
          "properties": {
            "type": { "const": "url" },
            "url": { "type": "string", "format": "uri" },
            "published_at": {
              "anyOf": [
                { "type": "string", "format": "date-time" },
                { "type": "null" }
              ]
            },
            "version": {
              "anyOf": [
                { "type": "string", "minLength": 1 },
                { "type": "null" }
              ]
            },
            "artifact_size_bytes": {
              "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
            },
            "license_status": {
              "enum": ["osi-approved", "proprietary", "missing", "pending"]
            },
            "license_spdx_id": {
              "anyOf": [
                { "type": "string", "minLength": 1 },
                { "type": "null" }
              ]
            }
          }
        }
      ]
    },
    "frontends": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "primary_function": {
      "enum": [
        "frontend",
        "memory-retrieval",
        "generation-reasoning",
        "character-worldbuilding",
        "rpg-systems",
        "interface-workflow",
        "developer-infrastructure",
        "uncategorized"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "cataloged_at": { "type": "string", "format": "date-time" },
    "catalog_cohort": { "enum": ["seed", "standard"] },
    "visibility": { "enum": ["published", "quarantined", "disabled"] },
    "visibility_reason": {
      "enum": [
        "identity-change",
        "source-unavailable",
        "removed",
        "safety-review",
        null
      ]
    },
    "refresh_policy": { "enum": ["automatic", "paused"] },
    "enrichment_policy": { "enum": ["automatic", "manual"] },
    "enrichment_note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    }
  },
  "allOf": [
    {
      "if": { "properties": { "visibility": { "const": "published" } } },
      "then": { "properties": { "visibility_reason": { "type": "null" } } }
    },
    {
      "if": {
        "properties": {
          "visibility": { "enum": ["quarantined", "disabled"] }
        }
      },
      "then": {
        "properties": {
          "visibility_reason": {
            "enum": [
              "identity-change",
              "source-unavailable",
              "removed",
              "safety-review"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "enrichment_policy": { "const": "manual" }
        },
        "required": ["enrichment_policy"]
      },
      "then": { "required": ["enrichment_note"] }
    },
    {
      "if": {
        "properties": {
          "enrichment_policy": { "const": "automatic" }
        },
        "required": ["enrichment_policy"]
      },
      "then": {
        "not": { "required": ["enrichment_note"] }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "type": { "enum": ["url", "github-organization"] }
            },
            "required": ["type"]
          }
        },
        "required": ["source"]
      },
      "then": {
        "properties": {
          "enrichment_policy": { "const": "manual" }
        }
      }
    }
  ]
}
