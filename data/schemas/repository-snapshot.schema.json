{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tavernary.org/schemas/repository-snapshot.schema.json",
  "title": "Tavernary generated repository snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "repository",
    "source_health",
    "activity",
    "community",
    "license",
    "refreshed_at",
    "stale_since"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "name",
        "url",
        "default_branch",
        "head_sha",
        "archived",
        "created_at",
        "size_kb"
      ],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "default_branch": { "type": "string", "minLength": 1 },
        "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "archived": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" },
        "size_kb": { "type": "integer", "minimum": 0 }
      }
    },
    "source_health": {
      "enum": ["healthy", "unavailable", "identity-change"]
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latest_meaningful_commit_at",
        "weekly_meaningful_commits",
        "active_weeks_12",
        "strength",
        "dormant",
        "latest_release_at"
      ],
      "properties": {
        "latest_meaningful_commit_at": {
          "anyOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "weekly_meaningful_commits": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 },
          "minItems": 12,
          "maxItems": 12
        },
        "active_weeks_12": { "type": "integer", "minimum": 0, "maximum": 12 },
        "strength": { "type": "number", "minimum": 0 },
        "dormant": { "type": "boolean" },
        "latest_release_at": {
          "anyOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        }
      }
    },
    "community": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stargazers_count",
        "forks_count",
        "subscribers_count",
        "aggregate"
      ],
      "properties": {
        "stargazers_count": { "type": "integer", "minimum": 0 },
        "forks_count": { "type": "integer", "minimum": 0 },
        "subscribers_count": { "type": "integer", "minimum": 0 },
        "aggregate": { "type": "integer", "minimum": 0 }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "spdx_id", "source_path"],
      "properties": {
        "status": { "enum": ["osi-approved", "proprietary", "missing"] },
        "spdx_id": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "source_path": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        }
      }
    },
    "refreshed_at": { "type": "string", "format": "date-time" },
    "stale_since": {
      "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }]
    }
  }
}
