{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tavernary.org/schemas/repository-snapshot.schema.json",
  "title": "Tavernary generated repository snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "repository",
    "source_health",
    "activity",
    "community",
    "license",
    "refreshed_at",
    "stale_since"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "project_id": { "type": "string", "minLength": 1 },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "name",
        "url",
        "default_branch",
        "head_sha",
        "head_committed_at",
        "archived",
        "created_at",
        "size_kb"
      ],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "description": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "default_branch": { "type": "string", "minLength": 1 },
        "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "head_committed_at": {
          "anyOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "archived": { "type": "boolean" },
        "fork": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" },
        "size_kb": { "type": "integer", "minimum": 0 }
      }
    },
    "contributors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accounts", "refreshed_at", "stale_since"],
      "properties": {
        "accounts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["login", "type"],
            "properties": {
              "login": { "type": "string", "minLength": 1 },
              "type": { "type": "string", "minLength": 1 }
            }
          }
        },
        "method": {
          "enum": ["repository-contributors", "merged-pull-requests"]
        },
        "baseline_completed_at": {
          "anyOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "scan": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["next_page", "cutoff_at", "target_watermark"],
              "properties": {
                "next_page": { "type": "integer", "minimum": 1 },
                "cutoff_at": {
                  "anyOf": [
                    { "type": "string", "format": "date-time" },
                    { "type": "null" }
                  ]
                },
                "target_watermark": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            },
            { "type": "null" }
          ]
        },
        "refreshed_at": { "type": "string", "format": "date-time" },
        "stale_since": {
          "anyOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        }
      }
    },
    "source_health": {
      "enum": [
        "healthy",
        "unavailable",
        "identity-change",
        "deleted",
        "private"
      ]
    },
    "activity_scan": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "head_sha",
            "cutoff_at",
            "next_page",
            "next_index",
            "resolved_weeks"
          ],
          "properties": {
            "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "cutoff_at": { "type": "string", "format": "date-time" },
            "next_page": { "type": "integer", "minimum": 1 },
            "next_index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99
            },
            "pending_commit": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "sha",
                    "committed_at",
                    "parent_count",
                    "next_file_page",
                    "source_path_seen",
                    "substantive_patch_seen",
                    "patch_incomplete"
                  ],
                  "properties": {
                    "sha": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40}$"
                    },
                    "committed_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "parent_count": { "type": "integer", "minimum": 0 },
                    "next_file_page": { "type": "integer", "minimum": 2 },
                    "source_path_seen": { "type": "boolean" },
                    "substantive_patch_seen": { "type": "boolean" },
                    "patch_incomplete": { "type": "boolean" }
                  }
                },
                { "type": "null" }
              ]
            },
            "resolved_weeks": {
              "type": "array",
              "maxItems": 12,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            }
          }
        },
        { "type": "null" }
      ]
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latest_source_activity_at",
        "source_weeks",
        "provisional_weeks",
        "latest_release_at",
        "evidence_status",
        "baseline_completed_at",
        "baseline_attempts"
      ],
      "properties": {
        "evidence_head_sha": {
          "anyOf": [
            { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            { "type": "null" }
          ]
        },
        "latest_source_activity_at": {
          "anyOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "source_weeks": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["week_start", "latest_at", "precision"],
            "properties": {
              "week_start": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "latest_at": { "type": "string", "format": "date-time" },
              "precision": { "enum": ["exact", "interval"] }
            }
          }
        },
        "provisional_weeks": {
          "anyOf": [
            {
              "type": "array",
              "items": { "type": "boolean" },
              "minItems": 12,
              "maxItems": 12
            },
            { "type": "null" }
          ]
        },
        "latest_release_at": {
          "anyOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "evidence_status": {
          "enum": ["provisional", "complete", "degraded"]
        },
        "baseline_completed_at": {
          "anyOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "baseline_attempts": { "type": "integer", "minimum": 0 }
      }
    },
    "community": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stargazers_count",
        "forks_count",
        "subscribers_count",
        "aggregate"
      ],
      "properties": {
        "stargazers_count": { "type": "integer", "minimum": 0 },
        "forks_count": { "type": "integer", "minimum": 0 },
        "subscribers_count": { "type": "integer", "minimum": 0 },
        "aggregate": { "type": "integer", "minimum": 0 }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "spdx_id", "source_path"],
      "properties": {
        "status": { "enum": ["osi-approved", "proprietary", "missing"] },
        "spdx_id": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "source_path": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        }
      }
    },
    "refreshed_at": { "type": "string", "format": "date-time" },
    "stale_since": {
      "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }]
    }
  }
}
