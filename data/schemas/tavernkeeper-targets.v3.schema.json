{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tavernary.org/schemas/tavernkeeper-targets.v3.schema.json",
  "title": "TavernKeeper V3 ranked scan target manifest",
  "type": "object",
  "properties": {
    "schema_version": { "type": "number", "const": 3 },
    "generated_at": { "type": "string", "format": "date-time" },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": { "type": "string", "pattern": "^github-[1-9][0-9]*$" },
          "provider": { "type": "string", "const": "github" },
          "repository_id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "repository": {
            "type": "string",
            "pattern": "^[^/\\s]+\\/[^/\\s]+$"
          },
          "target_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "canonical_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https:\\/\\/github\\.com\\/.*"
          },
          "project_kinds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": ["extension", "frontend", "preset"]
            }
          },
          "catalog_priority": {
            "type": "object",
            "properties": {
              "top_30": { "type": "boolean" },
              "first_cataloged_at": { "type": "string", "format": "date-time" },
              "popularity_rank": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": ["top_30", "first_cataloged_at", "popularity_rank"],
            "additionalProperties": false
          }
        },
        "required": [
          "source_id",
          "provider",
          "repository_id",
          "repository",
          "target_sha",
          "canonical_url",
          "project_kinds",
          "catalog_priority"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "generated_at", "repositories"],
  "additionalProperties": false
}
