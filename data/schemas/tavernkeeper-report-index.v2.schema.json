{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mentallyquill.github.io/TavernKeeper/schemas/report-index.v2.schema.json",
  "title": "TavernKeeper V2 preferred report index",
  "type": "object",
  "properties": {
    "schema_version": { "type": "number", "const": 2 },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "reports": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "report_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "report_version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "supersedes_report_id": {
            "anyOf": [
              { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              { "type": "null" }
            ]
          },
          "scanner_version": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
          },
          "scanner_policy_version": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
          },
          "prompt_policy_version": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
          },
          "source_id": { "type": "string", "pattern": "^github-[1-9][0-9]*$" },
          "provider": { "type": "string", "const": "github" },
          "repository_id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "repository": {
            "type": "string",
            "pattern": "^[^/\\s]+\\/[^/\\s]+$"
          },
          "target_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "completed_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          },
          "mode": { "type": "string", "enum": ["standard", "deep"] },
          "result": { "type": "string", "enum": ["teal", "red"] },
          "finding_counts": {
            "type": "object",
            "properties": {
              "total": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "actionable": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "severity": {
                "type": "object",
                "properties": {
                  "critical": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "high": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "medium": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "low": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "info": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": ["critical", "high", "medium", "low", "info"],
                "additionalProperties": false
              },
              "confidence": {
                "type": "object",
                "properties": {
                  "high": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "medium": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "low": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": ["high", "medium", "low"],
                "additionalProperties": false
              },
              "categories": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "category": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": ["category", "count"],
                  "additionalProperties": false
                }
              },
              "disposition": {
                "type": "object",
                "properties": {
                  "confirmed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "not_supported": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "inconclusive": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": ["confirmed", "not_supported", "inconclusive"],
                "additionalProperties": false
              }
            },
            "required": [
              "total",
              "actionable",
              "severity",
              "confidence",
              "categories",
              "disposition"
            ],
            "additionalProperties": false
          },
          "coverage": {
            "type": "object",
            "properties": {
              "history_commits": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "inventory_files": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "inventory_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "tools_completed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "tools_not_applicable": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "model_chunks": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "history_commits",
              "inventory_files",
              "inventory_bytes",
              "tools_completed",
              "tools_not_applicable",
              "model_chunks"
            ],
            "additionalProperties": false
          },
          "report_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https:\\/\\/mentallyquill\\.github\\.io\\/TavernKeeper\\/reports\\/.*"
          },
          "history_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https:\\/\\/mentallyquill\\.github\\.io\\/TavernKeeper\\/reports\\/.*"
          }
        },
        "required": [
          "report_id",
          "report_version",
          "supersedes_report_id",
          "scanner_version",
          "scanner_policy_version",
          "prompt_policy_version",
          "source_id",
          "provider",
          "repository_id",
          "repository",
          "target_sha",
          "completed_at",
          "mode",
          "result",
          "finding_counts",
          "coverage",
          "report_url",
          "history_url"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "generated_at", "reports"],
  "additionalProperties": false
}
