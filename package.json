{
  "name": "tavernary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run catalog:build && next dev",
    "build": "npm run catalog:build && next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "search:benchmark": "vitest run tests/benchmarks/catalog-search-benchmark.test.ts --reporter=verbose",
    "test:content": "vitest run tests/unit/validate-catalog.test.ts tests/unit/build-catalog.test.ts tests/unit/full-catalog-data.test.ts tests/unit/validate-kits.test.ts tests/unit/static-export-verification.test.ts tests/unit/playwright-runner.test.ts",
    "test:e2e": "node scripts/run-playwright.mjs tests/e2e",
    "test:scan": "node scripts/run-playwright.mjs --scan-fixture --project=chromium tests/e2e/catalog.spec.ts tests/visual/catalog.visual.spec.ts --grep \"hydrates (unscanned|current)|scan indicator\"",
    "test:scan-e2e": "node scripts/run-playwright.mjs --scan-fixture --workers=2 tests/e2e/catalog.spec.ts tests/e2e/catalog-mobile-performance.spec.ts --grep \"hydrates (unscanned|current)|TavernKeeper mobile|TavernKeeper catalog cost\"",
    "test:content-e2e": "node scripts/run-playwright.mjs tests/e2e/static-export.spec.ts",
    "test:visual": "node scripts/run-playwright.mjs --project=chromium tests/visual",
    "test:scan-visual": "node scripts/run-playwright.mjs --scan-fixture --project=chromium tests/visual/catalog.visual.spec.ts --grep \"scan indicator\"",
    "build:test-kits": "node scripts/kits/build-test-export.mjs",
    "test:kits-e2e": "node scripts/run-playwright.mjs --config playwright.kits.config.ts kits.spec.ts",
    "test:kits-visual": "node scripts/run-playwright.mjs --config playwright.kits.config.ts kits.visual.spec.ts",
    "palette:audit": "node scripts/audit-palette.mjs",
    "catalog:validate": "node scripts/catalog/validate.mjs",
    "catalog:refresh": "node scripts/catalog/refresh-repositories.mjs",
    "catalog:evidence:refresh": "node scripts/catalog/catalog-evidence.mjs",
    "catalog:enrich": "node scripts/catalog/enrich-readmes.mjs",
    "catalog:enrichment-plan": "node scripts/catalog/enrichment-rollout-plan.mjs",
    "catalog:enrichment-rollout": "node scripts/catalog/enrichment-orchestrator.mjs",
    "catalog:report-enrichment-errors": "node scripts/catalog/enrichment-issue.mjs",
    "catalog:select-canary": "node scripts/catalog/select-enrichment-canary.mjs",
    "catalog:backfill-identities": "node scripts/catalog/backfill-repository-identities.mjs",
    "catalog:taxonomy:discover": "node scripts/catalog/discover-tag-taxonomy.mjs",
    "catalog:tags:backfill": "node scripts/catalog/backfill-project-tags.mjs",
    "security:import-reports": "node scripts/security/import-tavernkeeper-reports.mjs",
    "security:validate-reports": "node scripts/security/validate-tavernkeeper-reports.mjs",
    "support:refresh-usage": "node scripts/support/refresh-openai-usage.mjs",
    "submissions:backfill-forks": "node scripts/submissions/backfill-fork-dependencies.mjs",
    "submissions:reconcile-kits": "node scripts/submissions/kit-submission-reconciliation.mjs --repo MentallyQuill/Tavernary",
    "submissions:reconcile-kits:apply": "node scripts/submissions/kit-submission-reconciliation.mjs --repo MentallyQuill/Tavernary --apply",
    "catalog:build": "node scripts/catalog/build.mjs",
    "verify:export": "node scripts/verify-static-export.mjs",
    "check": "npm run format:check && npm run lint && npm run palette:audit && npm run catalog:validate && npm run security:validate-reports && npm run catalog:build && npm run typecheck && npm test && npm run build && npm run verify:export",
    "check:content": "npm run format:check && npm run catalog:validate && npm run catalog:build && npm run test:content && npm run build && npm run verify:export"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "ajv": "^8.20.0",
    "minisearch": "^7.2.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "ajv-formats": "^3.0.1",
    "color-name": "^2.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
