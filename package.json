{
  "name": "tavernary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run catalog:build && next dev",
    "build": "npm run catalog:build && next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-playwright.mjs tests/e2e",
    "test:visual": "node scripts/run-playwright.mjs tests/visual",
    "build:test-kits": "node scripts/kits/build-test-export.mjs",
    "test:kits-e2e": "node scripts/run-playwright.mjs --config playwright.kits.config.ts kits.spec.ts",
    "test:kits-visual": "node scripts/run-playwright.mjs --config playwright.kits.config.ts kits.visual.spec.ts",
    "palette:audit": "node scripts/audit-palette.mjs",
    "catalog:validate": "node scripts/catalog/validate.mjs",
    "catalog:refresh": "node scripts/catalog/refresh-github.mjs",
    "catalog:enrich": "node scripts/catalog/enrich-readmes.mjs",
    "catalog:select-canary": "node scripts/catalog/select-enrichment-canary.mjs",
    "catalog:backfill-identities": "node scripts/catalog/backfill-repository-identities.mjs",
    "catalog:migrate": "node scripts/catalog/migrate-intake.mjs",
    "catalog:build": "node scripts/catalog/build.mjs",
    "verify:export": "node scripts/verify-static-export.mjs",
    "check": "npm run format:check && npm run lint && npm run palette:audit && npm run catalog:validate && npm run catalog:build && npm run typecheck && npm test && npm run build && npm run verify:export"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "ajv": "^8.20.0",
    "next": "^16.2.11",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "color-name": "^1.1.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
